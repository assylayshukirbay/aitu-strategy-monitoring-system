@startuml
left to right direction

actor "Strategy Staff" as Staff
actor "Department Representative" as Dept
actor "University Management" as Mgmt
actor "Administrator" as Admin

rectangle "AITU Strategy Monitoring System" {
  usecase "Sign In" as UC1
  usecase "Manage Strategic Goals\nand KPIs" as UC2
  usecase "Manage Annual Targets" as UC3
  usecase "Enter Actual KPI Results" as UC4
  usecase "View KPI Progress" as UC5
  usecase "Generate Reports" as UC6
  usecase "Manage Users\nand Permissions" as UC7
  usecase "View Change History" as UC8
}

Staff -- UC1
Staff -- UC2
Staff -- UC3
Staff -- UC5
Staff -- UC6
Staff -- UC8

Dept -- UC1
Dept -- UC4
Dept -- UC5

Mgmt -- UC1
Mgmt -- UC5
Mgmt -- UC6

Admin -- UC1
Admin -- UC7
@enduml
